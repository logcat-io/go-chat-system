CHAT_DATABASE_URL=postgres://chat:chat@127.0.0.1:56432/chat?sslmode=disable
CHAT_ADDR=:8090
# 시드 계정은 `server migrate`·`server bootstrap` 이 만든다. 서버 기동은 DB 에 쓰지 않는다(D49).
# 비밀번호 기본값은 없다 — CHAT_SEED_DEMO=true 인데 비어 있으면 migrate·bootstrap 이 실패한다.
CHAT_SEED_AGENT_EMAIL=agent@example.com
CHAT_SEED_AGENT_PASSWORD=chat1234
# 앞에 선 역프록시 수. 0 이면 X-Forwarded-For 를 믿지 않는다.
CHAT_TRUSTED_PROXIES=0
# true 면 migrate·bootstrap 이 데모 상담원(위 비밀번호)과 빠른 답변을 만든다. 기본 false. 공개 설치는 첫 관리자를 만든 뒤 false.
CHAT_SEED_DEMO=true
# 마이그레이션 러너(server migrate)의 시한(D49). 서버는 쓰지 않는다. 비우면 기본값이다.
# CHAT_MIGRATE_LOCK_TIMEOUT=3s        # 트랜잭션 파일 DDL 이 잠금을 기다리는 한도. 그동안 그 표의 질의가 DDL 뒤에 줄을 선다(CONCURRENTLY 파일에는 걸지 않는다)
# CHAT_MIGRATE_STATEMENT_TIMEOUT=60s  # 트랜잭션 파일의 문장 하나의 한도(CONCURRENTLY 파일에는 걸지 않는다)
# CHAT_MIGRATE_RETRIES=5              # 잠금을 못 잡았을 때 다시 하는 횟수. 0 이면 다시 하지 않는다(음수는 거부)
# CHAT_MIGRATE_ADVISORY_WAIT=60s      # 다른 migrate 가 끝나기를 기다리는 한도
# 첨부 저장소. local 은 서버 디스크(서버 한 대일 때), s3 는 S3 호환 객체 저장소. 브라우저가 저장소로 직접 올리고 받는다.
CHAT_STORAGE=s3
CHAT_MAX_UPLOAD_MB=100
# 아래는 docker compose 의 MinIO 기준이다. AWS S3 면 엔드포인트를 리전 주소로, PATH_STYLE 을 false 로 바꾼다.
CHAT_S3_ENDPOINT=http://127.0.0.1:59100
# 서버와 브라우저가 저장소를 다른 주소로 부를 때만 채운다.
CHAT_S3_PUBLIC_ENDPOINT=
CHAT_S3_REGION=us-east-1
CHAT_S3_BUCKET=chat-attachments
CHAT_S3_ACCESS_KEY=chat
CHAT_S3_SECRET_KEY=chatchat123
CHAT_S3_PATH_STYLE=true
# 브라우저가 올리는 방식. post 는 양식 업로드(AWS S3·MinIO), put 은 서명된 PUT 주소(양식 업로드가 없는 S3 호환 저장소). design.md D42.
CHAT_S3_UPLOAD=post
# 뜰 때 버킷을 만든다. 운영 버킷은 미리 만들어 두고 false 로 둔다.
# 운영 버킷에는 수명 주기 규칙(접두사 tmp/, 1일 뒤 만료)을 건다. 확인한 뒤 다시 올린 임시 객체는 서버가 지우지 않는다.
CHAT_S3_CREATE_BUCKET=true
# 양식 업로드(POST policy)가 없는 S3 호환 저장소로 바꿀 때는 위 묶음을 이렇게 바꾼다. 올리기 방식이 put 이다.
# CHAT_S3_ENDPOINT=https://<저장소의 S3 API 주소>
# CHAT_S3_PUBLIC_ENDPOINT=            # 서버와 브라우저가 같은 주소를 쓰면 비운다
# CHAT_S3_REGION=<저장소가 정한 리전 이름>
# CHAT_S3_BUCKET=<bucket>
# CHAT_S3_ACCESS_KEY=<Access Key ID>
# CHAT_S3_SECRET_KEY=<Secret Access Key>
# CHAT_S3_PATH_STYLE=false            # 저장소가 가상 호스트 방식 주소(https://<bucket>.<host>/<key>)를 쓰면 false
# CHAT_S3_UPLOAD=put
# CHAT_S3_CREATE_BUCKET=false
# 운영 로그. json 이면 한 줄 JSON 이라 수집기가 그대로 읽는다. 로컬은 text 가 읽기 편하다.
CHAT_LOG_FORMAT=text
# debug·info·warn·error. debug 면 WebSocket 프레임 단위 전달까지 남긴다.
CHAT_LOG_LEVEL=info
# 관측(트레이스·지표). 비우면 아무것도 내보내지 않는다. 로컬 컬렉터: docker compose --profile otel up -d otel-collector
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=go-chat-system
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
